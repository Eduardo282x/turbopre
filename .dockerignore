# Dependencies and build output
**/node_modules
**/dist
**/.turbo
**/.vite
**/coverage
**/.cache

# Git and local tooling
.git
.gitignore
.github
.vscode
.idea

# Prisma client and incremental build metadata. Both are regenerated inside the
# image, and the local copies must not leak into the build context.
apps/backend/src/generated
**/*.tsbuildinfo

# Mockup reference is not needed at build time
apps/frontend/reference

# Documentation, local environment and logs
docs
*.md
**/.env
**/.env.*
!**/.env.example
*.log
