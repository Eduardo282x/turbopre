NODE_ENV=development
PORT=3000

# Orígenes permitidos, separados por comas.
# Soporta comodines de subdominio: https://*.vercel.app
# Ejemplo QA: http://localhost:5173,https://turbopre.vercel.app,https://*.vercel.app
CORS_ORIGIN=http://localhost:5173

# Conexión a PostgreSQL (reemplaza USUARIO y PASSWORD).
# Ejemplo: postgresql://postgres:postgres@localhost:5432/turbopre?schema=public
DATABASE_URL="postgresql://USUARIO:PASSWORD@localhost:5432/turbopre?schema=public"

# Firma de los JWT (mínimo 32 caracteres)
JWT_SECRET="cambia-este-secreto-por-uno-de-al-menos-32-bytes"
JWT_EXPIRES_IN="1d"

# Seed (opcional).
# SEED_ADMIN_PASSWORD cambia la contraseña del administrador al sembrar.
# SEED_DEMO_USERS=true crea un usuario demo por rol con contraseña demo1234.
# Por defecto los usuarios demo se crean en desarrollo y se omiten con NODE_ENV=production.
SEED_ADMIN_PASSWORD="admin1234"
SEED_DEMO_USERS="true"
