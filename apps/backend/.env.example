NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Conexión a PostgreSQL (reemplaza USUARIO y PASSWORD).
# Ejemplo: postgresql://postgres:postgres@localhost:5432/turbopre?schema=public
DATABASE_URL="postgresql://USUARIO:PASSWORD@localhost:5432/turbopre?schema=public"

# Firma de los JWT (mínimo 32 caracteres)
JWT_SECRET="cambia-este-secreto-por-uno-de-al-menos-32-bytes"
JWT_EXPIRES_IN="1d"

# true: inicia sesión con el usuario demo en memoria (no requiere base de datos).
# false: valida el usuario contra PostgreSQL mediante Prisma.
AUTH_DEMO=true
