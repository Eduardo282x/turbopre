# syntax=docker/dockerfile:1

# ============================================================
# TurboPre — Backend (NestJS + Prisma 7 + pnpm monorepo)
# Build context: repository root
#
# The frontend keeps its own Dockerfile; this image only ships the API.
# ============================================================

FROM node:22-alpine AS build

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN npm install -g pnpm@11.21.0

WORKDIR /app

# Workspace manifests first, so dependency installation is cached separately
# from the application source. The Prisma schema and config must be present
# before installing because the backend's postinstall runs `prisma generate`.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY apps/backend/prisma ./apps/backend/prisma
COPY apps/backend/prisma.config.ts ./apps/backend/prisma.config.ts

RUN pnpm install --frozen-lockfile --filter backend --filter @turbopre/shared

COPY packages/shared ./packages/shared
COPY apps/backend ./apps/backend

# `shared` must be built first: the backend imports @turbopre/shared at runtime.
# The explicit `db:generate` guarantees the Prisma client matches the schema
# even if the postinstall was skipped by a package manager setting.
RUN pnpm --filter @turbopre/shared build \
  && pnpm --filter backend db:generate \
  && pnpm --filter backend build

# ------------------------------------------------------------
# Runtime: production dependencies + compiled output only
# ------------------------------------------------------------
FROM node:22-alpine AS runner

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NODE_ENV=production
ENV PORT=3000

RUN npm install -g pnpm@11.21.0

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY packages/shared/package.json ./packages/shared/package.json

# `--ignore-scripts` avoids re-running Prisma's postinstall: the generated
# client is already compiled into `apps/backend/dist`.
RUN pnpm install --frozen-lockfile --prod --ignore-scripts \
  --filter backend --filter @turbopre/shared

COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/apps/backend/dist ./apps/backend/dist
COPY --from=build /app/apps/backend/prisma/schema.prisma ./apps/backend/prisma/schema.prisma

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health >/dev/null 2>&1 || exit 1

CMD ["node", "apps/backend/dist/main.js"]
