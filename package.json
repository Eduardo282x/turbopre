{
  "name": "turbopre",
  "version": "0.1.0",
  "private": true,
  "description": "TurboPre — monorepo con frontend React (Vite) y backend NestJS",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter frontend dev",
    "dev:api": "pnpm --filter backend dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "turbo run format",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "db:studio": "pnpm --filter backend db:studio"
  },
  "devDependencies": {
    "turbo": "^2.11.11"
  }
}
